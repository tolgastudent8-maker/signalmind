# Yapay zekâ sağlayıcısı: anahtarlardan en az biri gerekli.
# İkisi de tanımlıysa Claude kullanılır (AI_PROVIDER=gemini ile değiştirilebilir).

# Anthropic Claude: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Varsayılan model tüm ajanlar için:
# SIGNALMIND_MODEL=claude-opus-5-5
# Ajan bazında model (isteğe bağlı, krediyi azaltır). Örnek karma:
# CLAUDE_MODEL_NEWS=claude-haiku-5-5
# CLAUDE_MODEL_IMPACT=claude-sonnet-5-5
# CLAUDE_MODEL_BULL=claude-sonnet-5-5
# CLAUDE_MODEL_BEAR=claude-sonnet-5-5
# CLAUDE_MODEL_JUDGE=claude-opus-5-5
# CLAUDE_MODEL_STRATEGY=claude-opus-5-5

# Google Gemini (ücretsiz katman, kart gerekmez): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-flash-latest,gemini-3.6-flash,gemini-3-flash-preview

# AI_PROVIDER=claude

# OKX TR API anahtarı — YALNIZCA "Okuma" yetkisiyle. ATK news modülünü açar (haber + duygu).
# Boş bırakılırsa Guard ajanı AUTH_MISSING hatasını görür ve RSS arşiviyle devam eder.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Avalanche Fuji (ERC-8004 kimliği + karar kaydı). Kurulum:
#   node --experimental-strip-types scripts/chain-setup.ts   (cüzdan üretir, adresi yazdırır)
#   faucet: https://core.app/tools/testnet-faucet/?subnet=c&token=c
#   node --experimental-strip-types scripts/chain-deploy.ts  (sözleşme + ajan kaydı)
# YALNIZCA testnet cüzdanı; gerçek anahtar koymayın.
CHAIN_PRIVATE_KEY=
CHAIN_REGISTRY=
CHAIN_AGENT_ID=
# CHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# GUARD_PUBLIC_URL=   (agent card'da servis adresi olarak yayınlanır)